//@version=6
indicator("NIFTY 200 Scanner - Sector RSI Bridge", overlay = false)

// =============================================================================
// NIFTY 200 Scanner - Sector RSI Bridge
//
// Place this on a SECTOR INDEX chart (e.g. NSE:NIFTYBANK, NSE:CNXIT,
// NSE:CNXHEALTH, NSE:CNXPHARMA...) - one chart+alert per sector you want to
// cover. It sends ONLY that sector's own D/W/M RSI to the backend as a
// SECTOR_RSI signal (backend/services/tradingview_service.py), used SOLELY
// as a last-resort fallback in backend/sector_analysis/engine.py when
// neither Tapetide nor Angel One can supply weekly/monthly RSI for that
// sector (see backend/config/sector_angelone_mapping.py - only ~9 of ~21
// mapped sectors have a real Angel One equivalent).
//
// This does NOT touch, replace, or feed into per-stock strategy evaluation
// in any way - it exists only to strengthen sector-qualification coverage
// (Strategy One/GFS/Advanced GFS/PRD/NRD all gate on sector qualification
// first). Per-stock analysis (price/RSI/strategies) still always comes from
// Tapetide/Angel One exactly as before.
//
// IMPORTANT: the `Sector Name (must match backend)` input below MUST equal
// the exact NSE index name backend/config/sector_mapping.py resolves to for
// this sector (e.g. "Nifty Healthcare", "Nifty Bank", "Nifty Oil & Gas") -
// the backend looks up TradingView's stored signal by this exact string
// (case-insensitive). A typo here means the fallback silently never matches
// and that sector just stays on its existing Tapetide/Angel One/UNAVAILABLE
// path - it can never crash or corrupt anything either way.
//
// "Confirmed candle" rule: identical to nifty200_scanner_signals.pine -
// weekly/monthly RSI here are read via the confirmed-higher-timeframe
// pattern (f_confirmed below), so a still-forming weekly/monthly bar can
// never be sent.
// =============================================================================

sectorName = input.string("Nifty Bank", "Sector Name (must match backend/config/sector_mapping.py exactly)")
webhookSecret = input.string("", "Webhook Secret (TRADINGVIEW_WEBHOOK_SECRET)")
rsiLen = input.int(14, "RSI Length")
sendDaily = input.bool(false, "Also send daily RSI (optional - backend already sources daily from Tapetide/Angel One reliably)")

f_confirmed(res, expr) =>
    request.security(syminfo.tickerid, res, expr[barstate.isrealtime ? 1 : 0], lookahead = barmerge.lookahead_off)

dailyRSI = ta.rsi(close, rsiLen)
weeklyRSI = f_confirmed("W", ta.rsi(close, rsiLen))
monthlyRSI = f_confirmed("M", ta.rsi(close, rsiLen))

f_isoTime() => str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

// Fires once per confirmed bar close on whatever timeframe the chart/alert
// is set to (typically Weekly or Monthly for this script's purpose) -
// never mid-bar/speculative.
if barstate.isconfirmed
    dailyField = sendDaily ? ',"daily_rsi":' + str.tostring(dailyRSI, "#.##") : ""
    alert('{"source":"tradingview","symbol":"' + sectorName + '","strategy":"SECTOR_RSI","timeframe":"' + timeframe.period + '","signal_date":"' + f_isoTime() + '"' + dailyField + ',"weekly_rsi":' + str.tostring(weeklyRSI, "#.##") + ',"monthly_rsi":' + str.tostring(monthlyRSI, "#.##") + ',"signal":true,"secret":"' + webhookSecret + '"}', alert.freq_once_per_bar_close)

plot(dailyRSI, title = "Daily RSI", color = color.blue)
plot(weeklyRSI, title = "Weekly RSI (confirmed)", color = color.orange)
plot(monthlyRSI, title = "Monthly RSI (confirmed)", color = color.red)
hline(60, "60")
hline(45, "45")
