# Database (defaults to local SQLite for dev; swap to Postgres in production)
DATABASE_URL=sqlite:///./scanner.db

# Cache (defaults to a local disk-backed cache for dev; swap to redis:// in production)
CACHE_URL=file://.cache/scanner_cache.pkl

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# Angel One SmartAPI — the ONLY market-data provider in this project (OHLCV,
# Daily/Weekly/Monthly candles, RSI, all calculations).
# apiKey: from your app registered at smartapi.angelone.in
# clientCode: your Angel One login/client ID
# pin: your Angel One trading PIN
# totpSecret: the Base32 secret shown when you enable external TOTP in
#   Angel One account settings (NOT a 6-digit code — the secret itself)
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=

# TradingView webhook — OPTIONAL additional signal source (Pine Script alert
# -> webhook -> DB -> scanner UI). Disabled by default; the scanner behaves
# exactly as it does today when this stays false. When enabled, TradingView
# alerts must send TRADINGVIEW_WEBHOOK_SECRET back in the request so the
# webhook can reject unauthorized/forged deliveries.
TRADINGVIEW_ENABLED=false
TRADINGVIEW_WEBHOOK_SECRET=

# OneDrive Excel sync (optional). One worksheet per scan inside ONE permanent
# workbook. Get the refresh token once with: python tools/onedrive_auth.py <client_id>
ONEDRIVE_WORKBOOK_URL=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT=consumers
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REFRESH_TOKEN=
