# Database (defaults to local SQLite for dev; swap to Postgres in production)
DATABASE_URL=sqlite:///./scanner.db

# Cache (defaults to a local disk-backed cache for dev, so re-running the app
# doesn't re-spend Tapetide's daily MCP call quota; swap to redis:// in production)
CACHE_URL=file://.cache/tapetide_cache.pkl

# Tapetide MCP is accessed through the Claude Code MCP connection, not an HTTP API key.
# No credentials are stored in this app for it.

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# Angel One SmartAPI — used ONLY for intraday (15m/1h) OHLCV for the
# Expiry Level 1 strategy, since Tapetide has no intraday history at all.
# apiKey: from your app registered at smartapi.angelone.in
# clientCode: your Angel One login/client ID
# pin: your Angel One trading PIN
# totpSecret: the Base32 secret shown when you enable external TOTP in
#   Angel One account settings (NOT a 6-digit code — the secret itself)
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
